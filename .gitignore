# ---------------------------------------------------------------
# Unity generated / machine-local folders
# ---------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Never ignore Asset meta files - Unity needs them and so does git
!/[Aa]ssets/**/*.meta

# Asset Store tools plugin
/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# ---------------------------------------------------------------
# IDE / editor files
# ---------------------------------------------------------------
.vs/
.idea/
.vsconfig
.consulo/

# VS Code: Unity regenerates these per machine, but keep the
# shared extension recommendations so new members get prompted.
.vscode/*
!.vscode/extensions.json

# ---------------------------------------------------------------
# Solution / project files (regenerated by Unity on open)
# ---------------------------------------------------------------
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for the above
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---------------------------------------------------------------
# Build outputs / distributables
# ---------------------------------------------------------------
*.apk
*.aab
*.app
*.ipa
*.unitypackage
*.unitypackage.meta

# Manual project snapshots - git replaces these, don't commit them
*.zip

# ---------------------------------------------------------------
# Crashlytics / OS cruft
# ---------------------------------------------------------------
crashlytics-build.properties
sysinfo.txt
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
